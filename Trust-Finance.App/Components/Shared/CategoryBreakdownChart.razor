@using ApexCharts
@inject ThemeState Theme

@* Spending by category — expenses only, value at the tip. *@
<ApexChart @key="Theme.Current" TItem="CategorySpend" Options="_options" Height="@Height">
    <ApexPointSeries TItem="CategorySpend" Items="Data" Name="Gasto" SeriesType="SeriesType.Bar"
                     XValue="@(c => c.Category)" YValue="@(c => c.Total)" />
</ApexChart>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CategorySpend> Data { get; set; } = [];

    private ApexChartOptions<CategorySpend> _options = new();

    private int Height => Math.Max(160, Data.Count * 40 + 24);

    protected override void OnParametersSet()
    {
        var palette = ChartPalette.For(Theme.IsDark);
        _options = palette.BaseOptions<CategorySpend>();
        _options.Colors = [palette.Expense];
        _options.PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true, BarHeight = "55%", BorderRadius = 4, BorderRadiusApplication = BorderRadiusApplication.End }
        };
        _options.DataLabels = new DataLabels
        {
            Enabled = true,
            TextAnchor = TextAnchor.Start,
            OffsetX = 8,
            Style = new DataLabelsStyle { Colors = [palette.Secondary], FontWeight = "500" },
            Formatter = ChartPalette.CompactCurrencyFormatter
        };
        _options.Xaxis = new XAxis { Labels = new XAxisLabels { Show = false }, AxisTicks = new AxisTicks { Show = false }, AxisBorder = new AxisBorder { Show = false } };
        _options.Grid = new Grid { Show = false, Padding = new Padding { Right = 56 } };
        _options.Legend = new Legend { Show = false };
    }
}
