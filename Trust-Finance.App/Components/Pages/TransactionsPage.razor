@page "/lancamentos"
@inject TransactionService Transactions
@inject RecurrenceService Recurrences
@inject CategoryService Categories
@inject CurrentUser CurrentUser
@inject TimeProvider Clock

<PageTitle>Lançamentos · Trust Finance</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Lançamentos</h1>
        <p class="page-subtitle">Receitas e despesas do seu caixa</p>
    </div>
    <a href="recorrentes" class="btn-soft">Recorrentes</a>
</div>

<section class="card">
    <h2 class="card-title">@(_editingId is null ? "Novo lançamento" : "Editar lançamento")</h2>
    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="inline-form">
        <label>
            Descrição
            <InputText @bind-Value="_form.Description" maxlength="100" />
        </label>
        <label>
            Valor
            <InputNumber @bind-Value="_form.Amount" step="0.01" min="0.01" />
        </label>
        <label>
            Data
            <InputDate @bind-Value="_form.Date" />
        </label>
        <label>
            Tipo
            <InputSelect @bind-Value="_form.Type">
                <option value="@TransactionType.Expense">Despesa</option>
                <option value="@TransactionType.Income">Receita</option>
            </InputSelect>
        </label>
        <label>
            Categoria
            <InputSelect @bind-Value="_form.CategoryId">
                <option value="0" disabled>Escolha…</option>
                @foreach (var c in _categories ?? [])
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </InputSelect>
        </label>
        <div class="form-actions">
            <button type="submit" class="btn-primary" disabled="@_saving">
                @(_editingId is null ? "Adicionar" : "Salvar")
            </button>
            @if (_editingId is not null)
            {
                <button type="button" class="btn-ghost" @onclick="CancelEdit">Cancelar</button>
            }
        </div>
    </EditForm>
    <ErrorList Messages="_formErrors" />
    @if (_categories is { Count: 0 })
    {
        <p class="page-status">
            Crie uma categoria primeiro — todo lançamento precisa de uma.
            <a href="categorias" class="card-link">Ir para categorias</a>
        </p>
    }
</section>

<section class="card">
    <div class="card-header">
        <div class="chip-row" role="group" aria-label="Período">
            @foreach (var preset in Presets)
            {
                <button type="button" class="chip @(_preset == preset ? "selected" : null)"
                        @onclick="() => SelectPresetAsync(preset)">@PresetLabel(preset)</button>
            }
        </div>
        @if (_transactions is { Count: > 0 })
        {
            <div class="period-totals">
                <span class="text-income sensitive">+@Money.Format(_income)</span>
                <span class="text-expense sensitive">−@Money.Format(_expense)</span>
                <span class="period-balance sensitive @(_balance < 0 ? "text-expense" : null)">= @Money.Signed(_balance)</span>
            </div>
        }
    </div>
    @if (_preset == Preset.Custom)
    {
        <div class="inline-form period-range">
            <label>
                De
                <InputDate TValue="DateOnly?" Value="_from" ValueExpression="() => _from" ValueChanged="SetFromAsync" />
            </label>
            <label>
                Até
                <InputDate TValue="DateOnly?" Value="_to" ValueExpression="() => _to" ValueChanged="SetToAsync" />
            </label>
        </div>
    }
    <ErrorList Messages="_listErrors" />
    @if (_savedOutside is { } saved)
    {
        <p class="page-status">Lançamento de @saved.ToString("dd/MM/yyyy") salvo — está fora do período exibido.</p>
    }
    @if (_transactions is null)
    {
        <p class="page-status">Carregando lançamentos…</p>
    }
    else if (_transactions.Count == 0)
    {
        <p class="page-status">@(_preset == Preset.All ? "Nenhum lançamento ainda." : "Nenhum lançamento neste período.")</p>
    }
    else
    {
        <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Tipo</th>
                    <th class="num">Valor</th>
                    <th class="actions" aria-label="Ações"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _transactions)
                {
                    var income = t.Type == TransactionType.Income;
                    <tr>
                        <td data-label="Data">@t.Date.ToString("dd/MM/yyyy")</td>
                        <td data-label="Descrição">
                            @t.Description
                            @if (t.IsRecurring)
                            {
                                <span class="badge badge-muted badge-tag" title="Lançado por uma recorrência">Recorrente</span>
                            }
                        </td>
                        <td data-label="Categoria">@(_categoryNames.GetValueOrDefault(t.CategoryId, "—"))</td>
                        <td data-label="Tipo"><span class="badge @(income ? "badge-income" : "badge-expense")">@(income ? "Receita" : "Despesa")</span></td>
                        <td data-label="Valor" class="num sensitive @(income ? "text-income" : "text-expense")">@Money.Signed(t.Amount, t.Type)</td>
                        <td class="actions">
                            <button type="button" class="btn-ghost" @onclick="() => StartEdit(t)">Editar</button>
                            <ConfirmButton Message="@($"Excluir \"{t.Description}\"?")" OnConfirmed="() => DeleteAsync(t)">
                                Excluir
                            </ConfirmButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</section>

@code {
    private int _userId;
    private List<Transaction>? _transactions;
    private List<Category>? _categories;
    private Dictionary<int, string> _categoryNames = new();
    private TransactionForm _form = new();
    private int? _editingId;
    private bool _saving;
    private List<string> _formErrors = [];
    private List<string> _listErrors = [];

    private Preset _preset = Preset.ThisMonth;
    private DateOnly? _from;
    private DateOnly? _to;
    private decimal _income;
    private decimal _expense;
    private decimal _balance;
    private DateOnly? _savedOutside;

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.IdAsync();
        _form = TransactionForm.Empty(Today);
        _categories = await Categories.GetAllAsync(_userId);
        _categoryNames = _categories.ToDictionary(c => c.Id, c => c.Name);

        // Anything that fell due since the app was last opened lands before the list is read.
        await Recurrences.PostDueAsync(_userId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _transactions = await Transactions.GetAsync(_userId, CurrentPeriod);
        _income = _transactions.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount);
        _expense = _transactions.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount);
        _balance = _income - _expense;
    }

    // ---------------------------------------------------------------- period

    private enum Preset { ThisMonth, LastMonth, ThreeMonths, ThisYear, All, Custom }

    private static readonly Preset[] Presets = Enum.GetValues<Preset>();

    private static string PresetLabel(Preset p) => p switch
    {
        Preset.ThisMonth => "Este mês",
        Preset.LastMonth => "Mês passado",
        Preset.ThreeMonths => "3 meses",
        Preset.ThisYear => "Este ano",
        Preset.All => "Tudo",
        _ => "Personalizado"
    };

    private Period CurrentPeriod => _preset switch
    {
        Preset.ThisMonth => Period.ThisMonth(Today),
        Preset.LastMonth => Period.LastMonth(Today),
        Preset.ThreeMonths => Period.LastThreeMonths(Today),
        Preset.ThisYear => Period.ThisYear(Today),
        Preset.Custom => new Period(_from, _to),
        _ => Period.All
    };

    private async Task SelectPresetAsync(Preset preset)
    {
        _savedOutside = null;

        // Custom starts from the range that was showing, so the user adjusts rather than re-types.
        if (preset == Preset.Custom && _preset != Preset.Custom)
            (_from, _to) = (CurrentPeriod.From, CurrentPeriod.To);

        _preset = preset;
        await LoadAsync();
    }

    private async Task SetFromAsync(DateOnly? value)
    {
        _from = value;
        await LoadAsync();
    }

    private async Task SetToAsync(DateOnly? value)
    {
        _to = value;
        await LoadAsync();
    }

    // ------------------------------------------------------------------ form

    private async Task SaveAsync()
    {
        _saving = true;
        _formErrors = [];

        var result = _editingId is null
            ? await Transactions.CreateAsync(_form.ToTransaction(_userId))
            : await Transactions.UpdateAsync(_editingId.Value, _form.ToTransaction(_userId));

        if (result.Failed)
            _formErrors = result.Messages;
        else
        {
            // A row saved outside the range on screen would otherwise look like it vanished.
            var date = _form.Date ?? Today;
            _savedOutside = CurrentPeriod.Contains(date) ? null : date;

            CancelEdit();
            await LoadAsync();
        }

        _saving = false;
    }

    private void StartEdit(Transaction transaction)
    {
        _editingId = transaction.Id;
        _form = TransactionForm.From(transaction);
        _formErrors = [];
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = TransactionForm.Empty(Today);
    }

    private async Task DeleteAsync(Transaction transaction)
    {
        var result = await Transactions.DeleteAsync(transaction.Id, _userId);
        _listErrors = result.Messages;

        if (result.Success)
        {
            if (_editingId == transaction.Id) CancelEdit();
            await LoadAsync();
        }
    }
}
