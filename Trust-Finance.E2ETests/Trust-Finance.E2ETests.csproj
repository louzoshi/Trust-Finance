<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrustFinance.E2ETests</RootNamespace>
    <AssemblyName>TrustFinance.E2ETests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <!-- The app is launched as a process, not referenced: these tests drive the built
       binary exactly as a user would run it. The dependency is on the build, declared
       here so a solution build always produces it first. -->
  <ItemGroup>
    <ProjectReference Include="..\Trust-Finance.App\Trust-Finance.App.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
